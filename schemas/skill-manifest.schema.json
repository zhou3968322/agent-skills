{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Agent Skill Manifest Schema",
  "required": ["skill_meta", "execution", "input_schema", "output_schema"],
  "properties": {
    "skill_meta": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "display_name": {"type": "string"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "author": {"type": "string"},
        "description": {"type": "string"},
        "category": {"type": "string"},
        "tags": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["type", "entry"],
      "properties": {
        "type": {"type": "string", "enum": ["python", "shell", "powershell", "binary"]},
        "entry": {"type": "string"},
        "working_dir": {"type": "string"},
        "timeout": {"type": "integer", "minimum": 1}
      }
    },
    "input_schema": {"type": "object"},
    "output_schema": {"type": "object"},
    "platform_compatibility": {
      "type": "object",
      "properties": {
        "windows": {"type": "string", "enum": ["native", "emulated", "unsupported"]},
        "linux": {"type": "string", "enum": ["native", "emulated", "unsupported"]},
        "macos": {"type": "string", "enum": ["native", "emulated", "unsupported"]}
      }
    }
  }
}
